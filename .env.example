# DeepSeek-only extraction configuration:
# google_vertex (Vertex AI DeepSeek) or deepseek (official DeepSeek API)
LLM_PROVIDER=google_vertex
LLM_MODEL=deepseek-ai/deepseek-v3.1-maas
LLM_MAX_TOKENS=32768
LLM_TIMEOUT_SECONDS=300
VERTEX_CHUNK_CHARS=24000
VERTEX_WORDS_PER_READ=20000
VERTEX_PROMPT_TOKENS_PER_READ=2600
VERTEX_MAX_RETRIES=1
VERTEX_429_BASE_DELAY_SECONDS=10
VERTEX_RETRY_BASE_DELAY_SECONDS=5
VERTEX_RETRY_MAX_DELAY_SECONDS=60
VERTEX_MIN_REQUEST_INTERVAL_SECONDS=2

# Google Vertex AI DeepSeek tries this project API key first, then ADC.
# Keep secrets in .env / hosting secrets and never commit their real values.
GOOGLE_CLOUD_PROJECT=
VERTEX_AUTH_METHOD=adc
GOOGLE_API_KEY=
VERTEX_LOCATION=us-west2

# Optional direct DeepSeek connection. This is the only fallback from Vertex AI.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Local default; for production use Supabase/Postgres:
# postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite:///./data/app.db

# Optional. If blank the app uses an OpenStreetMap basemap in ArcGIS SDK.
ARCGIS_API_KEY=

# Optional Google Places (New) Text Search
GOOGLE_MAPS_API_KEY=

# Identify your application to public OSM Nominatim.
# For production/high volume, self-host or use a commercial provider instead.
NOMINATIM_USER_AGENT=HistoricalGISResearch/0.1 (replace-with-contact-email)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Historical sources
CHGIS_BASE_URL=https://chgis.hudci.org/tgaz

# Optional local catalog CSVs created from public downloads.
DILA_CSV=./data/dila_places.csv
CBDB_CSV=./data/cbdb_places.csv
MCGD_CSV=./data/mcgd_places.csv

# Coordinate classification thresholds
CONFIRMED_SCORE=0.86
POSSIBLE_SCORE=0.60
AGREEMENT_RADIUS_KM=5
